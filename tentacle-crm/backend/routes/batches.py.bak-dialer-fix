@batches_bp.delete("/<int:bid>")
@jwt_required()
def delete_batch(bid):
    b = Batch.query.get_or_404(bid)

    # If active, clear first
    if b.status == 'active':
        # Detach leads
        CrmLead.query.filter_by(batch_id=bid).update({'batch_id': None})
    else:
        CrmLead.query.filter_by(batch_id=bid).delete()

    db.session.delete(b)
    db.session.commit()
    return jsonify({"ok": True, "message": "Batch deleted"})


