@batches_bp.get("/<int:bid>/leads")
@jwt_required()
def batch_leads(bid):
    """Paginated leads from campaign's working table."""
    b = Batch.query.get_or_404(bid)
    page, size, offset = paginate_args()

    if not b.campaign_id:
        return jsonify({"total": 0, "page": 1, "pages": 1, "rows": []})

    campaign = CampaignFull.query.get(b.campaign_id)
    if not campaign or not campaign.working_table:
        return jsonify({"total": 0, "page": 1, "pages": 1, "rows": []})

    working_table = campaign.working_table

    if not table_exists(working_table):
        return jsonify({"total": 0, "page": 1, "pages": 1, "rows": []})

    total = db.session.execute(
        text(f'SELECT COUNT(*) FROM "{working_table}" WHERE batch_id = :bid'),
        {'bid': bid}
    ).scalar() or 0

    if total == 0:
        return jsonify({"total": 0, "page": 1, "pages": 1, "rows": []})

    rows_raw = db.session.execute(
        text(f'SELECT * FROM "{working_table}" WHERE batch_id = :bid ORDER BY id DESC LIMIT :lim OFFSET :off'),
        {'bid': bid, 'lim': size, 'off': offset}
    ).mappings().all()

    # Flatten for frontend (uses _id, _phone, _dialStatus format)
    rows = []
    for r in rows_raw:
        rd = dict(r)
        data_json = rd.get('data') or {}
        flat = {}
        flat.update(data_json)
        flat['_id'] = rd.get('id')
        flat['_phone'] = rd.get('phone')
        flat['_dialStatus'] = rd.get('dial_status')
        flat['_attempts'] = rd.get('total_attempts') or rd.get('attempts') or 0
        flat['_lastDialAt'] = rd.get('last_dial_at').isoformat() if rd.get('last_dial_at') else None
        flat['_lastDisposition'] = rd.get('last_disposition')
        flat['_priority'] = rd.get('priority')
        rows.append(flat)

    return jsonify({
        "total": total,
        "page": page,
        "size": size,
        "pages": (total + size - 1) // size,
        "rows": rows,
    })


