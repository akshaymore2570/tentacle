@batches_bp.get("/next-lead")
@jwt_required()
def next_lead():
    campaign_id = request.args.get('campaignId', type=int)
    sub_campaign = request.args.get('subCampaign', type=str)

    batch_q = Batch.query.filter(Batch.status == 'active')
    if campaign_id:
        batch_q = batch_q.filter(Batch.campaign_id == campaign_id)
    if sub_campaign:
        batch_q = batch_q.filter(Batch.sub_campaign == sub_campaign)

    batches = batch_q.order_by(Batch.priority.asc()).all()
    if not batches:
        return jsonify({"lead": None, "reason": "No active batches"})

    batch_ids = [b.id for b in batches]

    lead = db.session.execute(text('''
        SELECT * FROM ten_crm_leads
        WHERE batch_id = ANY(:bids)
          AND dial_status IN ('pending', 'retry')
        ORDER BY priority ASC, attempts ASC, id ASC
        LIMIT 1
    '''), {'bids': batch_ids}).mappings().first()

    if not lead:
        return jsonify({"lead": None, "reason": "No pending leads"})

    return jsonify({"lead": dict(lead), "batchId": lead['batch_id']})


