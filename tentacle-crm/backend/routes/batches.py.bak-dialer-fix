@batches_bp.post("/<int:bid>/upload")
@jwt_required()
def upload_file(bid):
    """
    Upload CSV file with leads.
    Data goes DIRECTLY to {campaign}_stagging table.
    """
    b = Batch.query.get_or_404(bid)

    if b.status == 'active':
        return jsonify({"error": "Cannot upload to active batch. Stop it first."}), 400

    if 'file' not in request.files:
        return jsonify({"error": "No file uploaded"}), 400

    file = request.files['file']
    if not file.filename:
        return jsonify({"error": "Empty file"}), 400

    ext = file.filename.rsplit('.', 1)[-1].lower()
    if ext not in ('csv', 'txt'):
        return jsonify({"error": "Only CSV files are supported"}), 400

    if not b.campaign_id:
        return jsonify({"error": "Batch not linked to campaign"}), 400

    if not b.crm_table_id:
        return jsonify({"error": "CRM table not assigned"}), 400

    campaign = CampaignFull.query.get(b.campaign_id)
    if not campaign:
        return jsonify({"error": "Campaign not found"}), 404

    # ★ Use CAMPAIGN's staging table
    staging_table = campaign.staging_table
    if not staging_table:
        return jsonify({"error": "Campaign has no staging table"}), 400

    if not table_exists(staging_table):
        return jsonify({"error": f"Staging table {staging_table} does not exist"}), 400

    ct = CrmTable.query.get(b.crm_table_id)

    try:
        content = file.read().decode('utf-8', errors='ignore')
        reader = csv.DictReader(io.StringIO(content))
        rows = list(reader)

        if not rows:
            return jsonify({"error": "CSV has no data rows"}), 400

        total_rows = len(rows)

        # Get actual columns of staging table
        insp = inspect(db.engine)
        staging_cols = [c['name'] for c in insp.get_columns(staging_table)]

        # Reserved columns (auto-managed)
        reserved = {
            'id', 'batch_id', 'priority', 'dial_status',
            'total_attempts', 'total_connected', 'total_talk_time',
            'last_dial_at', 'next_dial_at', 'last_disposition',
            'last_agent_id', 'created_at', 'updated_at',
            'phone',  # ★ Already handled separately
        }

        # Delete old entries for this batch
        db.session.execute(
            text(f'DELETE FROM "{staging_table}" WHERE batch_id = :bid'),
            {'bid': bid}
        )
        db.session.commit()

        phone_col = get_phone_column(ct) if ct else None

        inserted = 0
        errors = 0

        for row in rows:
            row_clean = {k.strip(): v for k, v in row.items() if k and k.strip()}

            # Phone value
            phone = ''
            if phone_col and phone_col in row_clean:
                phone = str(row_clean[phone_col] or '').strip()
            else:
                for k, v in row_clean.items():
                    if 'phone' in k.lower() or 'mobile' in k.lower():
                        phone = str(v or '').strip()
                        break

            # Columns from CSV that exist in staging
            csv_cols = [k for k in row_clean.keys() if k in staging_cols and k not in reserved]

            # Build dynamic INSERT
            all_cols = list(csv_cols) + ['batch_id', 'priority', 'dial_status', 'phone', 'data']
            placeholders = []
            params = {}

            for i, c in enumerate(csv_cols):
                placeholders.append(f'"{c}"')
                params[f'c{i}'] = row_clean[c]

            placeholders.extend(['"batch_id"', '"priority"', '"dial_status"', '"phone"', '"data"'])

            value_sql_parts = [f':c{i}' for i in range(len(csv_cols))]
            value_sql_parts.extend([':p_batch', ':p_prio', ':p_status', ':p_phone', ':p_data'])

            params['p_batch'] = bid
            params['p_prio'] = b.priority or 3
            params['p_status'] = 'pending'
            params['p_phone'] = phone[:30] if phone else None
            params['p_data'] = json.dumps(row_clean)

            col_sql = ', '.join(placeholders)
            val_sql = ', '.join(value_sql_parts)

            stmt = text(f'''
                INSERT INTO "{staging_table}" ({col_sql})
                VALUES ({val_sql})
            ''')

            try:
                db.session.execute(stmt, params)
                inserted += 1
            except Exception as row_err:
                errors += 1
                print(f"[UPLOAD] Row insert error: {row_err}")
                continue

            if inserted % 200 == 0:
                db.session.flush()

        db.session.commit()

        # Update batch
        b.source_file = file.filename
        b.uploaded_rows = inserted
        if b.status not in ('active',):
            b.status = 'draft'
        db.session.commit()

        return jsonify({
            "ok": True,
            "message": f"{inserted} leads uploaded to {staging_table}",
            "inserted": inserted,
            "errors": errors,
            "totalRows": total_rows,
            "filename": file.filename,
            "stagingTable": staging_table,
        })

    except Exception as e:
        db.session.rollback()
        import traceback
        traceback.print_exc()
        return jsonify({"error": f"Upload failed: {str(e)}"}), 500



@batches_bp.get("/<int:bid>/upload-status")
@jwt_required()
def upload_status(bid):
    """Live count of uploaded rows for a batch."""
    b = Batch.query.get_or_404(bid)
    staged_count = CrmLead.query.filter_by(batch_id=bid).count()
    working_count = 0
    if b.status in ('active', 'paused') and b.crm_table_id:
        ct = CrmTable.query.get(b.crm_table_id)
        if ct:
            wname = working_table_name(ct.name)
            if table_exists(wname):
                try:
                    working_count = db.session.execute(
                        text(f'SELECT COUNT(*) FROM "{wname}" WHERE batch_id = :bid'),
                        {'bid': bid}
                    ).scalar() or 0
                except Exception:
                    working_count = 0

    return jsonify({
        "batchId": bid,
        "uploadedRows": b.uploaded_rows or 0,
        "stagedRows": staged_count,
        "workingRows": working_count,
        "sourceFile": b.source_file,
        "status": b.status,
        "canActivate": staged_count > 0,
    })


