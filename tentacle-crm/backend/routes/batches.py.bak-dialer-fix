"""
Batch Management — High Performance
Features:
- Dashboard stats (cached)
- CRUD batches
- File upload (CSV/Excel)
- Start (activate) → data to {crm}_working
- Stop (deactivate) → clear working
- Restart → stop + start
"""
import re
import io
import csv
import json
from datetime import datetime
from flask import Blueprint, request, jsonify
from flask_jwt_extended import jwt_required
from sqlalchemy import text, inspect
from extensions import db
from models import Batch, CrmTable, CampaignFull, CrmLead

batches_bp = Blueprint("batches", __name__, url_prefix="/api/batches")

PAGE_SIZE = 50
MAX_PAGE_SIZE = 200


# ============ HELPERS ============

def table_exists(tname):
    return tname in inspect(db.engine).get_table_names()


def sanitize_identifier(name):
    if not name:
        return None
    s = re.sub(r'[^a-zA-Z0-9_]', '_', str(name).strip().lower())
    s = re.sub(r'_+', '_', s).strip('_')
    if s and s[0].isdigit():
        s = 'c_' + s
    return s or None


def working_table_name(crm_table_name):
    base = sanitize_identifier(crm_table_name)
    return f"{base}_working" if base else None


def get_phone_column(crm_table):
    cols = crm_table.columns or []
    for c in cols:
        name = (c.get('name') or '').lower()
        if 'phone' in name or 'mobile' in name or 'cell' in name:
            return c.get('name')
    return cols[0].get('name') if cols else None


def compute_batch_stats(batch_id):
    sql = text('''
        SELECT
            COUNT(*) AS total,
            COUNT(*) FILTER (WHERE dial_status = 'pending') AS pending,
            COUNT(*) FILTER (WHERE dial_status = 'called') AS called,
            COUNT(*) FILTER (WHERE dial_status = 'connected') AS connected,
            COUNT(*) FILTER (WHERE dial_status = 'completed') AS completed,
            COUNT(*) FILTER (WHERE dial_status = 'failed') AS failed
        FROM ten_crm_leads
        WHERE batch_id = :bid
    ''')
    row = db.session.execute(sql, {'bid': batch_id}).mappings().first()
    if not row:
        return {"total": 0, "pending": 0, "called": 0, "connected": 0, "completed": 0, "failed": 0}
    return {
        "total": row['total'] or 0,
        "pending": row['pending'] or 0,
        "called": row['called'] or 0,
        "connected": row['connected'] or 0,
        "completed": row['completed'] or 0,
        "failed": row['failed'] or 0,
    }


def refresh_batch_cache(batch_id):
    stats = compute_batch_stats(batch_id)
    Batch.query.filter_by(id=batch_id).update({'cached_stats': stats})
    db.session.commit()
    return stats


def paginate_args():
    page = max(1, request.args.get('page', 1, type=int))
    size = min(MAX_PAGE_SIZE, max(1, request.args.get('size', PAGE_SIZE, type=int)))
    return page, size, (page - 1) * size


def ensure_working_table(working_name, staging_name):
    """Create working table if not exists (structure clone of staging)."""
    if table_exists(working_name):
        return
    # Clone structure only
    db.session.execute(text(f'CREATE TABLE "{working_name}" (LIKE "{staging_name}" INCLUDING DEFAULTS)'))
    # Add batch columns
    for col, ctype in [
        ('batch_id', 'INTEGER'),
        ('priority', 'SMALLINT'),
        ('dial_status', 'VARCHAR(20) DEFAULT \'pending\''),
        ('assigned_agent_id', 'INTEGER'),
        ('attempts', 'SMALLINT DEFAULT 0'),
        ('last_dial_at', 'TIMESTAMP'),
        ('last_disposition', 'VARCHAR(80)'),
        ('last_agent_id', 'INTEGER'),
    ]:
        db.session.execute(text(f'ALTER TABLE "{working_name}" ADD COLUMN IF NOT EXISTS "{col}" {ctype}'))
    # Index
    db.session.execute(text(f'CREATE INDEX IF NOT EXISTS idx_{working_name}_batch ON "{working_name}" (batch_id, dial_status, priority, id)'))
    db.session.commit()


