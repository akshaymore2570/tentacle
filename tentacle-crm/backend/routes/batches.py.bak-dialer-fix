@batches_bp.post("")
@jwt_required()
def create_batch():
    data = request.get_json() or {}
    name = (data.get("name") or "").strip()
    if not name:
        return jsonify({"error": "Batch name is required"}), 400

    crm_table_id = data.get("crmTableId")
    if not crm_table_id:
        return jsonify({"error": "CRM Table is required"}), 400

    ct = CrmTable.query.get(crm_table_id)
    if not ct:
        return jsonify({"error": "CRM table not found"}), 404

    staging_name = ct.staging_table_name()
    working_name = working_table_name(ct.name)

    b = Batch(
        name=name,
        description=data.get("description") or "",
        campaign_id=data.get("campaignId") or None,
        sub_campaign=data.get("subCampaign") or "",
        crm_table_id=crm_table_id,
        priority=int(data.get("priority") or 3),
        status="draft",
        cached_stats={"total": 0, "pending": 0, "called": 0, "connected": 0, "completed": 0, "failed": 0},
        staging_table=staging_name,
        uploaded_rows=0,
    )
    db.session.add(b)
    db.session.commit()
    return jsonify(b.to_dict()), 201


