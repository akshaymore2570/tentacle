@batches_bp.get("")
@jwt_required()
def list_batches():
    status = request.args.get('status')
    search = (request.args.get('search') or '').strip().lower()
    campaign_id = request.args.get('campaignId', type=int)

    q = Batch.query
    if status and status != 'all':
        if status == 'active':
            q = q.filter(Batch.status.in_(['active', 'paused']))
        elif status == 'inactive':
            q = q.filter(Batch.status.in_(['inactive', 'completed']))
        else:
            q = q.filter(Batch.status == status)
    if campaign_id:
        q = q.filter(Batch.campaign_id == campaign_id)
    if search:
        q = q.filter(db.func.lower(Batch.name).like(f'%{search}%'))

    batches = q.order_by(Batch.priority.asc(), Batch.created_at.desc()).all()

    # Batch-fetch campaign / CRM names (no N+1)
    campaign_ids = list({b.campaign_id for b in batches if b.campaign_id})
    crm_ids = list({b.crm_table_id for b in batches if b.crm_table_id})

    campaign_map = {}
    if campaign_ids:
        for c in CampaignFull.query.filter(CampaignFull.id.in_(campaign_ids)).all():
            campaign_map[c.id] = c.name
    crm_map = {}
    if crm_ids:
        for t in CrmTable.query.filter(CrmTable.id.in_(crm_ids)).all():
            crm_map[t.id] = t.name

    out = []
    for b in batches:
        d = b.to_dict()
        d['campaignName'] = campaign_map.get(b.campaign_id)
        d['crmTableName'] = crm_map.get(b.crm_table_id)
        stats = b.cached_stats or {}
        d['totalRecords'] = stats.get('total', b.total_records or 0)
        d['activeRecords'] = stats.get('called', 0)
        out.append(d)

    return jsonify(out)


