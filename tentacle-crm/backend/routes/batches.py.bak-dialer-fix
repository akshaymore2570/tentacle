@batches_bp.get("/stats")
@jwt_required()
def dashboard_stats():
    """Global stats for dashboard — one query."""
    sql = text('''
        SELECT
            COUNT(*) AS total_batches,
            COUNT(*) FILTER (WHERE status = 'active') AS active_batches,
            COUNT(*) FILTER (WHERE status = 'inactive') AS inactive_batches,
            COUNT(*) FILTER (WHERE status = 'draft') AS draft_batches,
            COALESCE(SUM((cached_stats->>'total')::int), 0) AS total_records
        FROM ten_batches
    ''')
    row = db.session.execute(sql).mappings().first()
    return jsonify({
        "totalBatches": row['total_batches'] or 0,
        "activeBatches": row['active_batches'] or 0,
        "inactiveBatches": row['inactive_batches'] or 0,
        "draftBatches": row['draft_batches'] or 0,
        "totalRecords": int(row['total_records'] or 0),
    })


