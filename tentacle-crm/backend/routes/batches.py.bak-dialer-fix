@batches_bp.post("/<int:bid>/start")
@jwt_required()
def start_batch(bid):
    """Activate batch — copy from {campaign}_stagging → {campaign}_working."""
    b = Batch.query.get_or_404(bid)

    if b.status == 'active':
        return jsonify({"error": "Batch is already active"}), 400

    if not b.campaign_id:
        return jsonify({"error": "Batch not linked to campaign"}), 400

    campaign = CampaignFull.query.get(b.campaign_id)
    if not campaign:
        return jsonify({"error": "Campaign not found"}), 404

    staging_table = campaign.staging_table
    working_table = campaign.working_table

    if not staging_table or not table_exists(staging_table):
        return jsonify({"error": f"Staging table {staging_table} does not exist"}), 400
    if not working_table:
        return jsonify({"error": "Campaign has no working table"}), 400

    try:
        # 1. Ensure working table exists
        if not table_exists(working_table):
            db.session.execute(text(f'CREATE TABLE "{working_table}" (LIKE "{staging_table}" INCLUDING DEFAULTS)'))
            db.session.commit()

        # 2. Clear existing rows for this batch
        db.session.execute(
            text(f'DELETE FROM "{working_table}" WHERE batch_id = :bid'),
            {'bid': bid}
        )
        db.session.commit()

        # 3. Count staged rows for this batch
        staged_count = db.session.execute(
            text(f"SELECT COUNT(*) FROM \"{staging_table}\" WHERE batch_id = :bid AND (dial_status IS NULL OR dial_status = 'pending')"),
            {'bid': bid}
        ).scalar() or 0

        if staged_count == 0:
            return jsonify({"error": "No leads to activate. Upload file first."}), 400

        # 4. Copy shared columns
        insp = inspect(db.engine)
        staging_cols = [c['name'] for c in insp.get_columns(staging_table)]
        working_cols = [c['name'] for c in insp.get_columns(working_table)]
        shared = [c for c in staging_cols if c in working_cols]

        col_sql = ', '.join(f'"{c}"' for c in shared)

        sql = text(f'''
            INSERT INTO "{working_table}" ({col_sql})
            SELECT {col_sql}
            FROM "{staging_table}"
            WHERE batch_id = :bid
              AND (dial_status IS NULL OR dial_status = 'pending')
        ''')

        result = db.session.execute(sql, {'bid': bid})
        inserted = result.rowcount or 0
        db.session.commit()

        # 5. Update batch
        working_count = db.session.execute(
            text(f'SELECT COUNT(*) FROM "{working_table}" WHERE batch_id = :bid'),
            {'bid': bid}
        ).scalar() or 0

        b.status = 'active'
        b.total_records = working_count
        b.activated_at = datetime.utcnow()
        b.paused_at = None
        b.inactivated_at = None
        b.cached_stats = {
            "total": working_count,
            "pending": working_count,
            "called": 0,
            "connected": 0,
            "completed": 0,
            "failed": 0,
        }
        db.session.commit()

        return jsonify({
            "ok": True,
            "message": f"Batch started — {inserted} leads loaded into working table",
            "inserted": inserted,
            "workingTable": working_table,
            "workingCount": working_count,
        })

    except Exception as e:
        db.session.rollback()
        import traceback
        traceback.print_exc()
        return jsonify({"error": f"Start failed: {str(e)}"}), 500



@batches_bp.post("/<int:bid>/stop")
@jwt_required()
def stop_batch(bid):
    """Deactivate — clear batch rows from working table."""
    b = Batch.query.get_or_404(bid)

    if b.status not in ('active', 'paused'):
        return jsonify({"error": "Batch is not active"}), 400

    if not b.crm_table_id:
        return jsonify({"error": "No CRM table linked"}), 400

    ct = CrmTable.query.get(b.crm_table_id)
    if not ct:
        return jsonify({"error": "CRM table not found"}), 404

    working_name = working_table_name(ct.name)
    deleted = 0

    if table_exists(working_name):
        try:
            result = db.session.execute(
                text(f'DELETE FROM "{working_name}" WHERE batch_id = :bid'),
                {'bid': bid}
            )
            deleted = result.rowcount or 0
            db.session.commit()
        except Exception as e:
            db.session.rollback()
            return jsonify({"error": f"Stop failed: {str(e)}"}), 500

    # Reset staged leads back to pending (keep them for re-activation)
    CrmLead.query.filter_by(batch_id=bid).update({'dial_status': 'pending'})
    db.session.commit()

    b.status = 'inactive'
    b.inactivated_at = datetime.utcnow()
    b.cached_stats = {"total": b.uploaded_rows or 0, "pending": b.uploaded_rows or 0, "called": 0, "connected": 0, "completed": 0, "failed": 0}
    db.session.commit()

    return jsonify({
        "ok": True,
        "message": f"Batch stopped — {deleted} records cleared from working table",
        "deleted": deleted,
    })


@batches_bp.post("/<int:bid>/restart")
@jwt_required()
def restart_batch(bid):
    """Restart — stop, then start again."""
    b = Batch.query.get_or_404(bid)

    # Stop first (if active/paused)
    if b.status in ('active', 'paused'):
        stop_batch(bid)
        b = Batch.query.get(bid)

    # Reset leads to pending
    CrmLead.query.filter_by(batch_id=bid).update({'dial_status': 'pending'})
    db.session.commit()

    # Start
    return start_batch(bid)


