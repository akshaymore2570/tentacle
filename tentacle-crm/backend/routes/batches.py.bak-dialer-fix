@batches_bp.put("/<int:bid>")
@jwt_required()
def update_batch(bid):
    b = Batch.query.get_or_404(bid)
    data = request.get_json() or {}

    if b.status == 'active':
        return jsonify({"error": "Cannot edit active batch. Stop it first."}), 400

    if 'name' in data: b.name = data['name']
    if 'description' in data: b.description = data['description']
    if 'campaignId' in data: b.campaign_id = data['campaignId'] or None
    if 'subCampaign' in data: b.sub_campaign = data['subCampaign'] or ""
    if 'crmTableId' in data:
        b.crm_table_id = data['crmTableId'] or None
        if b.crm_table_id:
            ct = CrmTable.query.get(b.crm_table_id)
            if ct:
                b.staging_table = ct.staging_table_name()
    if 'priority' in data: b.priority = int(data['priority'] or 3)

    db.session.commit()
    return jsonify(b.to_dict())


