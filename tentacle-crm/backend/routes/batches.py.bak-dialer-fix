@batches_bp.get("/<int:bid>")
@jwt_required()
def get_batch(bid):
    b = Batch.query.get_or_404(bid)
    d = b.to_dict()
    d['stagingTable'] = b.staging_table
    d['uploadedRows'] = b.uploaded_rows or 0
    d['sourceFile'] = b.source_file
    if b.campaign_id:
        c = CampaignFull.query.get(b.campaign_id)
        d['campaignName'] = c.name if c else None
    if b.crm_table_id:
        t = CrmTable.query.get(b.crm_table_id)
        d['crmTableName'] = t.name if t else None
        d['workingTable'] = working_table_name(t.name)
    return jsonify(d)


