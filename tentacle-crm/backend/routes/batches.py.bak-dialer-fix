@batches_bp.get("/<int:bid>/template")
@jwt_required()
def download_template(bid):
    """
    Download CSV template for batch upload.
    Headers = CRM table columns (which auto-created campaign tables).
    """
    from flask import Response
    import csv, io

    b = Batch.query.get_or_404(bid)

    if not b.crm_table_id:
        return jsonify({"error": "CRM table not assigned"}), 400

    ct = CrmTable.query.get(b.crm_table_id)
    if not ct:
        return jsonify({"error": "CRM table not found"}), 404

    # Get columns from CRM table definition
    cols = ct.columns or []
    col_names = [c.get('name') for c in cols if c.get('name')]

    if not col_names:
        return jsonify({"error": "CRM table has no columns"}), 400

    # Build CSV with headers + 2 sample rows
    buf = io.StringIO()
    writer = csv.writer(buf)
    writer.writerow(col_names)

    # Sample rows
    sample = []
    for c in cols:
        ctype = (c.get('type') or 'varchar').lower()
        if ctype == 'int':
            sample.append('123')
        elif ctype == 'date':
            sample.append('2025-01-01')
        elif ctype == 'boolean':
            sample.append('true')
        else:
            sample.append('sample_value')
    writer.writerow(sample)
    writer.writerow([''] * len(col_names))

    # Sanitize filename
    safe_name = re.sub(r'[^a-zA-Z0-9_-]', '_', b.name or 'batch')
    filename = f"template_{safe_name}.csv"

    return Response(
        buf.getvalue(),
        mimetype='text/csv',
        headers={'Content-Disposition': f'attachment; filename={filename}'},
    )
